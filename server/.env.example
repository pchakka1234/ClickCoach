PORT=3001
HOST=127.0.0.1
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Mock mode never calls an AI API.
AI_PROVIDER=mock

# Optional Gemini provider. Keep this key in server/.env only.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# Optional legacy OpenAI provider settings.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Copy the ID shown at chrome://extensions after loading client/dist.
EXTENSION_ID=YOUR_32_CHARACTER_EXTENSION_ID
